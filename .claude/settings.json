{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".specify/scripts/bash/check-worktree-sync.sh",
            "statusMessage": "Checking worktree sync..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".specify/scripts/bash/trim-noisy-bash-output.sh",
            "statusMessage": "Trimming noisy test/build output..."
          }
        ]
      }
    ]
  }
}
