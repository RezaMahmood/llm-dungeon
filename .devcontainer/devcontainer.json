// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/python:3-3.14-trixie",
	"features": {
		"ghcr.io/devcontainers/features/azure-cli:1": {},
		"ghcr.io/devcontainers/features/dotnet:2": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/terraform:1": {},
		"ghcr.io/devcontainers/features/node:1": {},
		// Docker access for the local offline test harness
		// (specs/027-local-offline-test-harness, FR-012): the Cosmos DB
		// emulator and Azurite run as *sibling* containers on the host
		// daemon, not nested inside this one. That is the daemon already in
		// play -- bin/wt runs `docker info` and `docker ps` against it
		// before `devcontainer up` -- so no new infrastructure is
		// introduced, and siblings share the host's image cache across
		// every worktree container rather than pulling the ~1GB emulator
		// image once per worktree, which docker-in-docker would do (and
		// would need a privileged container to do it). See
		// specs/027-local-offline-test-harness/research.md D2.
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
	},
	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},
	// The local offline stack's in-container ports, forwarded so the host's
	// browser can reach them (specs/027-local-offline-test-harness,
	// contracts/local-stack.md). Only these three run *inside* this
	// container: the SWA CLI is the stack's entry point (it is the only
	// component that reads staticwebapp.config.json), fronting the Vite dev
	// server and proxying /api to the Functions host.
	//
	// The Cosmos emulator and Azurite are deliberately absent: they run as
	// sibling containers and publish onto the *host's* port space directly,
	// so there is nothing for this container to forward. That same fact is
	// why several worktree containers running at once makes a port collision
	// the normal case rather than bad luck -- ports are derived per worktree
	// by tools/local-stack/ports.sh (research.md D8), which lands with the
	// stack itself in phase 5. The numbers below are that contract's *base*
	// ports.
	"forwardPorts": [
		4280, // SWA CLI -- the entry point; use this, not 5173
		5173, // Vite dev server
		7071 // Azure Functions host (`func start`)
	],
	// Use 'postCreateCommand' to run commands after the container is created.
	// See .devcontainer/post-create.sh -- installs uv and the Claude Code
	// CLI, with retries: their downloads were observed to fail
	// intermittently right after this container's image finished building.
	// It also installs the local offline test harness's toolchain at build
	// time (FR-012): a pinned Python 3.11 virtualenv with the project's
	// requirements, Azure Functions Core Tools v4, Azurite and the SWA CLI,
	// so a fresh container runs the full local suite with no manual setup.
	"postCreateCommand": "bash .devcontainer/post-create.sh",
	// Runs on every container start (create AND resume), unlike
	// postCreateCommand above which only fires once at creation -- needed
	// to refresh the container's local ~/.claude.json from the read-only
	// ~/.claude.json.host mount below on every start, since bin/wt resumes
	// (rather than recreates) a stopped container on every later run. See
	// restore-claude-config.sh.
	"postStartCommand": "bash .devcontainer/restore-claude-config.sh",
	// One container is created per git worktree (see bin/wt and
	// docs/WORKTREE_CONTAINER_WORKFLOW.md), all from this same image/config --
	// so these mounts are shared *across every worktree's container*:
	//  - ~/.claude: carries Claude Code's credentials/config directory in
	//    from the host so you don't have to `claude login` inside every
	//    container. Read-write: the `claude` installer itself needs to
	//    write its download cache to ~/.claude/downloads (confirmed while
	//    building this config -- a read-only mount here makes the
	//    installer fail with a misleading "client returned ERROR on write"
	//    from curl, not an obvious permissions error). This is a personal
	//    dev container running trusted code, so read-write here (same
	//    tradeoff as the very common ~/.ssh or ~/.gitconfig dev-container
	//    mount) is an accepted risk, not an oversight.
	//    NOTE: if your host stores the Claude Code credential in the macOS
	//    keychain rather than a file under ~/.claude, this mount alone won't
	//    carry it over -- verify after first use, and fall back to
	//    `claude login` (or an API key via ANTHROPIC_API_KEY) inside the
	//    container if needed.
	//  - ~/.claude.json (mounted read-only, at .host, NOT at its real
	//    path): this file alone carries the oauth account/onboarding state
	//    (oauthAccount, hasCompletedOnboarding, ...) that ~/.claude/
	//    doesn't -- without it every container got its own empty
	//    ~/.claude.json and forced a fresh login. It used to be bind-mounted
	//    read-write directly at ~/.claude.json, but Claude Code's atomic
	//    save (write temp, rename() over the real path) doesn't survive a
	//    single-file bind mount under Docker Desktop's virtiofs: a save
	//    from *any* side -- host or any one of several concurrently-running
	//    worktree containers, since this file was shared read-write across
	//    all of them -- could truncate the host's real ~/.claude.json to 0
	//    bytes instead of atomically replacing it, corrupting the live
	//    config for every other session sharing it (observed twice in one
	//    evening). Mounting it read-only under a different path removes the
	//    container's ability to ever write back through to the host file;
	//    restore-claude-config.sh (postStartCommand below) copies it into
	//    the container's own real ~/.claude.json -- an ordinary in-container
	//    file, not a mount -- on every start. Trade-off: auth/onboarding
	//    state changed *inside* a container (e.g. re-running `claude login`
	//    there) stays local to that container and is overwritten by the
	//    host's copy on the next start; that's fine since the actual OAuth
	//    token lives in ~/.claude/.credentials.json above, which is still
	//    read-write and shared normally.
	//  - ~/.config/gh: same idea for the `gh` CLI (installed via the
	//    github-cli feature above) -- it stores its login under
	//    $HOME/.config/gh (hosts.yml with the oauth token), not the
	//    macOS keychain, so mounting it is enough on any OS. Directory
	//    doesn't need to pre-exist: Docker creates it on the host the
	//    first time this mount is used, and `gh auth login` run once
	//    inside any worktree's container persists there for all of
	//    them (and survives --rebuild), same as the ~/.claude mounts.
	//  - ~/.azure: same idea again, for the Azure CLI (installed via the
	//    azure-cli feature above). `az` stores its login under $HOME/.azure
	//    (msal_token_cache.bin etc.), not a keychain, on any OS.
	//    `az login --use-device-code` cannot be run through Claude Code's
	//    `!` bash mode or its Bash tool -- both execute non-interactively
	//    (captured output, no stdin, a short timeout), and the device-code
	//    flow needs a real TTY to print the code and then poll for a few
	//    minutes while you finish auth in a browser. Run it once in a real
	//    interactive shell instead -- either on the host, or inside any
	//    worktree's container via `bin/wt <branch> --shell` -- and it
	//    persists to the host and is picked up by every other worktree's
	//    container from then on (including through --rebuild), same as the
	//    gh mount.
	//  - the uv and Terraform plugin-cache volumes are download caches, safe
	//    to share across worktrees/branches, and cut postCreateCommand /
	//    `terraform init` time on every container after the first.
	"mounts": [
		"source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
		"source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json.host,type=bind,readonly",
		"source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind",
		"source=${localEnv:HOME}/.azure,target=/home/vscode/.azure,type=bind",
		"source=llmdungeon-uv-cache,target=/home/vscode/.cache/uv,type=volume",
		"source=llmdungeon-tf-plugin-cache,target=/home/vscode/.terraform.d/plugin-cache,type=volume",
		//  - llmdungeon-tool-cache holds the pinned Azure Functions Core
		//    Tools archive (~250MB). Shared like the two caches above, so
		//    it is downloaded once per host rather than once per worktree
		//    container; post-create.sh re-verifies its checksum before
		//    reusing it.
		"source=llmdungeon-tool-cache,target=/home/vscode/.cache/llm-dungeon-tools,type=volume"
	],
	"remoteEnv": {
		"UV_CACHE_DIR": "/home/vscode/.cache/uv",
		"TF_PLUGIN_CACHE_DIR": "/home/vscode/.terraform.d/plugin-cache",
		// Put the Python 3.11 virtualenv that post-create.sh builds ahead of
		// the image's own 3.14 interpreter, so `python`, `pip` and `pytest`
		// resolve to it in every shell and every `devcontainer exec` -- which
		// is what makes `python --version` report 3.11.x, the version CI and
		// production actually run (SC-007). It also puts that interpreter on
		// PATH for `func start`, whose Python worker has no build for 3.14.
		//
		// This directory does not exist yet while postCreateCommand itself is
		// running; a missing PATH entry is simply skipped, and the venv is on
		// PATH from the first shell afterwards.
		"PATH": "/home/vscode/.venvs/llm-dungeon/bin:${containerEnv:PATH}"
	}
	// Configure tool-specific properties.
	// "customizations": {},
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}