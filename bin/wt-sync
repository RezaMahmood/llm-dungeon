#!/usr/bin/env bash
# bin/wt-sync [branch] [--ref=<ref>]
#
# Bootstrap-staleness report for the per-worktree devcontainer workflow
# (see docs/WORKTREE_CONTAINER_WORKFLOW.md).
#
# CLAUDE.md, the constitution, .claude/settings.json, the hook scripts,
# bin/* and .devcontainer/ are all *tracked* files, so every worktree holds
# its own copy frozen at the moment it was created. A worktree that has not
# rebased since then is governed by whatever those files said back then —
# issue #293 found four constitution versions live at once, spanning three
# majors, with nothing detecting or reporting it.
#
# The rule this implements (issue #293, "Decisions taken"):
#   - a constitution MAJOR-version gap BLOCKS  (exit 2)
#   - everything else WARNS                    (exit 0)
#
# Staleness is measured against the merge base, not the raw diff: a branch
# that deliberately *edits* CLAUDE.md or a hook is not stale, it is ahead.
# What matters is what landed on the ref since this branch diverged.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: bin/wt-sync [branch] [--ref=<ref>]

Reports which worktrees are running stale bootstrap files (CLAUDE.md, the
constitution, .claude/settings.json, hook scripts, bin/, .devcontainer/)
relative to <ref>.

With no branch, checks every worktree under .worktrees/ — run that from the
primary checkout, since an isolated worktree container cannot see its
siblings. Inside a worktree, checks that worktree.

Options:
  --ref=<ref>   Compare against this ref (default: origin/main, falling
                back to main).
  -h, --help    Show this help.

Exit codes: 0 = up to date or warnings only, 2 = a constitution major-version
gap (blocking), 1 = usage/environment error.
EOF
}

REF=""
ONLY_BRANCH=""
for arg in "$@"; do
  case "$arg" in
    --ref=*) REF="${arg#--ref=}" ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "Unknown option: $arg" >&2; usage >&2; exit 1 ;;
    *)
      if [[ -n "$ONLY_BRANCH" ]]; then
        echo "Only one branch may be given (got '$ONLY_BRANCH' and '$arg')." >&2
        exit 1
      fi
      ONLY_BRANCH="$arg"
      ;;
  esac
done

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Not inside a git repository." >&2
  exit 1
fi

if [[ -z "$REF" ]]; then
  if git rev-parse --verify --quiet origin/main >/dev/null; then
    REF="origin/main"
  else
    REF="main"
  fi
fi
if ! git rev-parse --verify --quiet "$REF" >/dev/null; then
  echo "Ref '$REF' does not exist. Fetch first, or pass --ref=<ref>." >&2
  exit 1
fi

# Tracked files that bootstrap a session's behaviour. A worktree running an
# older copy of any of these is running by yesterday's rules.
BOOTSTRAP_PATHS=(
  CLAUDE.md
  .specify/memory/constitution.md
  .specify/scripts/bash
  .claude/settings.json
  .claude/skills
  bin
  .devcontainer
)

CONSTITUTION_PATH=".specify/memory/constitution.md"

version_of_file() { # <file> -> X.Y.Z or empty
  [[ -f "$1" ]] || return 0
  grep -oE '^\*\*Version\*\*:[[:space:]]*[0-9]+\.[0-9]+\.[0-9]+' "$1" 2>/dev/null \
    | tail -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' || true
}

REF_CONSTITUTION="$(mktemp)"
trap 'rm -f "$REF_CONSTITUTION"' EXIT
git show "$REF:$CONSTITUTION_PATH" >"$REF_CONSTITUTION" 2>/dev/null || : >"$REF_CONSTITUTION"
REF_VERSION="$(version_of_file "$REF_CONSTITUTION")"

BLOCKING=0
WARNED=0

check_worktree() { # <path> <branch-label>
  local path="$1" label="$2"
  local mb stale_files wt_version ref_major wt_major

  echo "== $label"
  echo "   $path"

  wt_version="$(version_of_file "$path/$CONSTITUTION_PATH")"
  if [[ -n "$REF_VERSION" && -n "$wt_version" && "$wt_version" != "$REF_VERSION" ]]; then
    ref_major="${REF_VERSION%%.*}"
    wt_major="${wt_version%%.*}"
    if [[ "$wt_major" -lt "$ref_major" ]]; then
      echo "   BLOCKED: constitution v$wt_version, but $REF is v$REF_VERSION — a MAJOR-version gap."
      echo "            A session here would be governed by rules two majors old and may take actions the current constitution forbids."
      echo "            Rebase this worktree onto $REF before working in it:  git -C \"$path\" rebase $REF"
      BLOCKING=$((BLOCKING + 1))
    elif [[ "$wt_major" -gt "$ref_major" ]]; then
      echo "   ahead:   constitution v$wt_version vs $REF v$REF_VERSION — this branch amends it. Nothing to do."
    else
      echo "   warn:    constitution v$wt_version, $REF is v$REF_VERSION (minor/patch drift)."
      WARNED=$((WARNED + 1))
    fi
  fi

  mb="$(git -C "$path" merge-base HEAD "$REF" 2>/dev/null || true)"
  if [[ -z "$mb" ]]; then
    echo "   warn:    no merge base with $REF — cannot measure staleness."
    WARNED=$((WARNED + 1))
    echo
    return 0
  fi

  stale_files="$(git -C "$path" diff --name-only "$mb" "$REF" -- "${BOOTSTRAP_PATHS[@]}" 2>/dev/null || true)"
  if [[ -z "$stale_files" ]]; then
    echo "   ok:      bootstrap files match $REF."
  else
    echo "   warn:    $(printf '%s\n' "$stale_files" | wc -l | tr -d ' ') bootstrap file(s) changed on $REF since this branch diverged:"
    printf '%s\n' "$stale_files" | sed 's/^/            /'
    echo "            Rebase to pick them up:  git -C \"$path\" rebase $REF"
    if printf '%s\n' "$stale_files" | grep -q '^\.devcontainer/'; then
      echo "            .devcontainer/ changed — that one also needs a container rebuild:  bin/wt <branch> --rebuild"
    fi
    WARNED=$((WARNED + 1))
  fi
  echo
}

_common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
PRIMARY_REPO_ROOT="$(CDPATH= cd "$(dirname "$_common_dir")" && pwd -P)"
WORKTREES_ROOT="$PRIMARY_REPO_ROOT/.worktrees"

echo "Comparing against $REF ($(git rev-parse --short "$REF"))"
if [[ -n "$REF_VERSION" ]]; then
  echo "Constitution on $REF: v$REF_VERSION"
fi
echo

# Inside a container only this worktree is mounted, so there is nothing else
# to iterate over — check the current one and say so.
if [[ -n "${WORKTREE_CONTAINER:-}" && -z "$ONLY_BRANCH" ]]; then
  check_worktree "$(git rev-parse --show-toplevel)" "${WORKTREE_CONTAINER} (this container — siblings are not visible from here)"
else
  FOUND=0
  _path=""
  _branch=""
  while IFS= read -r line; do
    case "$line" in
      "worktree "*)
        if [[ -n "$_path" ]]; then
          if [[ "$_path" == "$WORKTREES_ROOT"/* ]] \
             && { [[ -z "$ONLY_BRANCH" ]] || [[ "$_branch" == "$ONLY_BRANCH" ]]; }; then
            FOUND=1
            check_worktree "$_path" "${_branch:-(detached)}"
          fi
        fi
        _path="${line#worktree }"
        _branch=""
        ;;
      "branch refs/heads/"*) _branch="${line#branch refs/heads/}" ;;
    esac
  done < <(git worktree list --porcelain)
  if [[ -n "$_path" && "$_path" == "$WORKTREES_ROOT"/* ]] \
     && { [[ -z "$ONLY_BRANCH" ]] || [[ "$_branch" == "$ONLY_BRANCH" ]]; }; then
    FOUND=1
    check_worktree "$_path" "${_branch:-(detached)}"
  fi

  if [[ "$FOUND" == "0" ]]; then
    if [[ -n "$ONLY_BRANCH" ]]; then
      echo "No worktree found for branch '$ONLY_BRANCH' under $WORKTREES_ROOT."
    else
      echo "No worktrees under $WORKTREES_ROOT."
    fi
    exit 0
  fi
fi

if [[ "$BLOCKING" -gt 0 ]]; then
  echo "$BLOCKING worktree(s) BLOCKED on a constitution major-version gap, $WARNED warned."
  exit 2
fi
echo "0 blocked, $WARNED warned."
exit 0
